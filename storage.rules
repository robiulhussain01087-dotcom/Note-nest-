rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Settings branding (official logo) - public read, authenticated admin write
    match /settings/branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Settings payment (official UPI QR code) - public read, authenticated admin write
    match /settings/payment/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Study notes assets (cover images, PDFs)
    match /notes/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Customer payment receipts and proof screenshots
    match /payments/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
