rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator'
        );
    }

    match /users/{userId} {
      // User can read their own profile, or Admin can read any
      allow read: if isOwner(userId) || isAdmin();
      
      // New registration can set role to 'customer' for their own uid
      allow create: if (isOwner(userId) && request.resource.data.role == 'customer') || isAdmin();
      
      // User cannot elevate their own role to 'admin'. Normalizing admin casing or admin role edits allowed.
      allow update: if (isOwner(userId) && (
        request.resource.data.role == resource.data.role ||
        (resource.data.role in ['admin', 'Admin', 'ADMIN', 'administrator', 'Administrator'] && request.resource.data.role == 'admin')
      )) || isAdmin();
      
      // Only Admin can delete accounts
      allow delete: if isAdmin();
    }
    
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      // Status changes and verification must be performed by admin only
      allow update: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid && request.resource.data.paymentStatus == resource.data.paymentStatus);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid && request.resource.data.status == 'pending';
      // Status approval/rejection must be performed by admin only
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Verified purchases & course access
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    
    // Notes catalog
    match /notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Syllabus Groups: Curriculum hierarchy
    // Students can read curriculum; only users with users/{uid}.role == "admin" can create, update, delete
    match /groups/{groupId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Chapters: Syllabus chapters
    // Students can read curriculum; only users with users/{uid}.role == "admin" can create, update, delete
    match /chapters/{chapterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Chapter sub-topics & learning units
    match /topics/{topicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Subscription & pricing plans
    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Public store & academic settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
